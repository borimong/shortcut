# 필수: OpenAI 키. Agent 모델 호출과 rag-mcp 임베딩에 쓴다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FALLBACK_MODEL=gpt-4.1-mini

# 선택: LangSmith trace. 키가 없으면 trace 없이 동작한다.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=shortcut

# 서비스 사이 비밀값. 32바이트 이상 임의 문자열로 바꾼다.
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
INTERNAL_TOKEN=change-me-internal-token

# 콜시트 배포 첫 시도를 일부러 실패시켜 재시도와 DLQ 동작을 보여 준다.
WORKER_FAIL_FIRST_ATTEMPT=true

# 호스트에서 접속할 포트
FRONTEND_HOST_PORT=8088
BACKEND_HOST_PORT=18080
