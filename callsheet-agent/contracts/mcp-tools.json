              "extra_constraints": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/ExtraConstraint"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Extra Constraints"
              }
            },
            "required": [
              "block_id",
              "ctx"
            ],
            "title": "evaluate_plansArguments"
          }
        },
