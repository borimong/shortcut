                "type": "string"
              },
              "ctx": {
                "additionalProperties": true,
                "description": "Agent가 자동 주입하는 사용자 컨텍스트 {id, role, projectId, taskId}. 모델은 채우지 않는다.",
                "title": "Ctx",
