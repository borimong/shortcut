        {
          "name": "evaluate_plans",
          "agentName": "business_evaluate_plans",
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false,
            "idempotentHint": true,
            "openWorldHint": false
          },
          "description": "1/2/3안을 현재 조건으로 다시 평가하고, 요소 단위 조합(최대 27개)을 backend 엔진이 전부 검증·채점해 순위를 돌려준다.\n반환: {evaluated, feasibleCount, ranked:[{choice, planHash, total(0~1), scores:{location,equipment,weather,budget,time,distance},\nextraCost(원), totalKm, recombined}], originalPlans:{P1:{feasible,total?}}, infeasibleByCode, weights, dataVersion}.\nweights는 감독이 가중치를 바꾸라고 했을 때만 넘긴다(예: 웃돈 OK → budget↓ location·equipment↑).\nextra_constraints에는 지난 루프 거절 사유를 넣는다. ranked가 비면 세 안 모두 불가이므로 사람에게 보고한다.",
          "inputSchema": {
            "type": "object",
            "$defs": {
              "ExtraConstraint": {
                "description": "승인자 거절 사유를 바꾼 추가 제약. 다음 루프부터 HARD로 검사된다.",
                "properties": {
                  "kind": {
                    "enum": [
                      "EXCLUDE_LOCATION",
                      "EXCLUDE_TIME_WINDOW",
                      "EXCLUDE_PACKAGE",
                      "MAX_EXTRA_COST"
                    ],
                    "title": "Kind",
                    "type": "string"
                  },
                  "locationId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "EXCLUDE_LOCATION, 또는 EXCLUDE_TIME_WINDOW를 특정 장소에만 걸 때",
                    "title": "Locationid"
                  },
                  "packageId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "EXCLUDE_PACKAGE",
                    "title": "Packageid"
                  },
                  "start": {
                    "anyOf": [
                      {
                        "description": "시각 HH:mm",
                        "pattern": "^\\d{2}:\\d{2}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "EXCLUDE_TIME_WINDOW 시작",
                    "title": "Start"
                  },
                  "end": {
                    "anyOf": [
                      {
                        "description": "시각 HH:mm",
                        "pattern": "^\\d{2}:\\d{2}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "EXCLUDE_TIME_WINDOW 끝",
                    "title": "End"
                  },
                  "amount": {
                    "anyOf": [
                      {
                        "minimum": 0,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "MAX_EXTRA_COST 상한(원)",
                    "title": "Amount"
                  },
                  "reason": {
                    "description": "거절 사유 원문 요약. 예: 성수 스튜디오 오후 공사 소음",
                    "title": "Reason",
                    "type": "string"
                  },
                  "fromRole": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "거절한 승인자 역할. 예: SOUND_LEAD",
                    "title": "Fromrole"
                  }
                },
                "required": [
                  "kind",
                  "reason"
                ],
                "title": "ExtraConstraint",
                "type": "object"
              },
              "Weights": {
                "description": "SOFT 6개 기준 가중치. 합이 1이 아니어도 backend가 정규화한다. 감독 지시가 없으면 넘기지 않는다.",
                "properties": {
                  "location": {
                    "minimum": 0,
                    "title": "Location",
                    "type": "number"
                  },
                  "equipment": {
                    "minimum": 0,
                    "title": "Equipment",
                    "type": "number"
                  },
                  "weather": {
                    "minimum": 0,
                    "title": "Weather",
                    "type": "number"
                  },
                  "budget": {
                    "minimum": 0,
                    "title": "Budget",
                    "type": "number"
                  },
                  "time": {
                    "minimum": 0,
                    "title": "Time",
                    "type": "number"
                  },
                  "distance": {
                    "minimum": 0,
                    "title": "Distance",
                    "type": "number"
                  }
                },
                "required": [
                  "location",
                  "equipment",
                  "weather",
                  "budget",
                  "time",
                  "distance"
                ],
                "title": "Weights",
                "type": "object"
              }
            },
            "properties": {
              "block_id": {
                "title": "Block Id",
                "type": "string"
              },
              "ctx": {
                "additionalProperties": true,
                "description": "Agent가 자동 주입하는 사용자 컨텍스트 {id, role, projectId, taskId}. 모델은 채우지 않는다.",
                "title": "Ctx",
                "type": "object"
